# Copie para deploy/.env (fora do Git) e preencha. Nunca faça commit do .env.

# Domínio servido pelo Caddy. Homologação: homolog.impactopapelaria.com.br. Teste local: localhost
DOMINIO=homolog.impactopapelaria.com.br

# Portas publicadas no host. Na VPS: 80 e 443. Localmente, se 80/443 estiverem ocupadas: 8080 e 8443
PORTA_HTTP=80
PORTA_HTTPS=443

# Senha do PostgreSQL (o banco só é acessível pela rede interna do compose)
POSTGRES_PASSWORD=troque-esta-senha

# Primeiro administrador, criado na primeira subida se ainda não houver nenhum (senha com 8+ caracteres)
IMPA_ADMIN_USUARIO=admin
IMPA_ADMIN_SENHA=troque-esta-senha
IMPA_ADMIN_NOME=Administrador

EMPRESA_NOME=Impacto Papelaria

# Chave da licença do MediatR (Community, gratuita): https://mediatr.io. Vazia: só um aviso no log
MEDIATR_LICENSE_KEY=

# Caminho do impa-frontend, relativo a deploy/ (padrão: clonado ao lado do impa-backend)
# CAMINHO_FRONTEND=../../impa-frontend
